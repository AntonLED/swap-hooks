__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Jupyter
.ipynb_checkpoints/

# MacOS files
.DS_Store

# Node
node_modules/
dist/

# Logs
logs/

# LaTeX build artifacts
# Tracked on purpose: *.tex, *.bib, *.cls, paper/Image/*, main.bbl, main.pdf.
# IEEE wants the .bbl at submission (they don't run BibTeX), so it stays.
*.aux
*.bcf
*.blg
*.brf
*.dvi
*.fdb_latexmk
*.figlist
*.fls
*.idx
*.ilg
*.ind
*.lof
*.log
*.lot
*.nav
*.out
*.run.xml
*.snm
*.spl
*.synctex.gz
*.toc
*.vrb
*.xdv

# Foundry build output.
# contracts/lib/ is deliberately NOT ignored: dependencies are git submodules,
# so only the pinned commit hashes are stored here, not their contents. Those
# hashes are field D of the reproducibility manifest.
contracts/out/
contracts/cache/
contracts/broadcast/
contracts/.forge-snapshots/

# Experiment IO
data/
results/

*_cache/

learning/
